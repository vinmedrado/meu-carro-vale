POSTGRES_DB=meu_carro_vale
POSTGRES_USER=meu_carro_vale
POSTGRES_PASSWORD=meu_carro_vale
DATABASE_URL=postgresql+psycopg2://meu_carro_vale:meu_carro_vale@postgres:5432/meu_carro_vale
JWT_SECRET=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5180,http://127.0.0.1:5180
APP_ENV=local
DEMO_MODE=true
REDIS_URL=redis://redis:6379/0

# Modos: DEMO usa dados de apresentação. REAL exige FIPE real/cache ou CSV de anúncios reais.
APP_MODE=DEMO
FIPE_CACHE_TTL_SECONDS=43200
MIN_COMPARABLE_SCORE=62

# Market Intelligence Real
MARKET_COLLECTION_ENABLED=false
MARKET_COLLECTOR_RATE_LIMIT_SECONDS=3
MARKET_CACHE_TTL_SECONDS=900

# Integração oficial com o mcv-data-engine
USE_DATA_ENGINE_EXPORTS=true
MCV_DATA_ENGINE_EXPORTS_PATH=../mcv-data-engine/exports

MCV_DATA_ENGINE_MODE=api
MCV_DATA_ENGINE_API_URL=http://127.0.0.1:8020
